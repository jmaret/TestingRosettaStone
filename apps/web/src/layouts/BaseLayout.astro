---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}

const {
  title = "Testing Playground",
  description = "Compare the same testing concepts across open-source frameworks — unit, integration, UX, and performance.",
  wide = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="apple-touch-icon" href="/images/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Outfit:wght@500;600;700;800&family=Source+Sans+3:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page-bg" aria-hidden="true"></div>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/">
        <img class="brand-logo" src="/images/logo.png" width="40" height="40" alt="" />
        <span>Testing Playground</span>
      </a>
      <nav aria-label="Primary">
        <a href="/scenarios">Scenarios</a>
        <a href="/ask">Ask AI</a>
        <a href="/local">Run locally</a>
      </nav>
    </header>
    <main id="main" class:list={{ wide }}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <p>Open source · Zero cost · Grounded AI answers</p>
        <p>
          <a href="https://github.com/jmaret/TestingRosettaStone">GitHub</a>
        </p>
      </div>
    </footer>
  </body>
</html>
