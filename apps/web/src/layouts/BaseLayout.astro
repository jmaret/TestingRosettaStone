---
import "../styles/global.css";
import { withBase } from "../lib/base";
import { RELEASE_VERSION } from "../lib/release";

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}

const {
  title = "Testing Playground",
  description = "Compare the same testing concepts across open-source frameworks — unit, integration, UX, performance, and security.",
  wide = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={withBase("/images/logo.png")} />
    <link rel="apple-touch-icon" href={withBase("/images/logo.png")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Source+Sans+3:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body style={`--page-bg-image: url('${withBase("/images/office-bg.png")}')`}>
    <div class="page-bg" aria-hidden="true"></div>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class:list={["site-header-inner", { wide }]}>
      <a class="brand" href={withBase("/")}>
        <img class="brand-logo" src={withBase("/images/logo.png")} width="36" height="36" alt="" />
        <span class="brand-text">
          <span class="brand-name">Testing Playground</span>
          <span class="brand-tag">Same idea, many frameworks.</span>
        </span>
      </a>
      <div class="header-actions">
        <nav aria-label="Primary">
          <a href={withBase("/scenarios")}>Scenarios</a>
          <a href={withBase("/ask")}>Ask AI</a>
          <a href={withBase("/vision")}>Vision</a>
          <a href={withBase("/architecture")}>Architecture</a>
          <a href={withBase("/quality")}>Quality</a>
          <a href={withBase("/local")}>Run locally</a>
        </nav>
        <a class="release" href={withBase(`/releases/${RELEASE_VERSION}`)} title={`Release ${RELEASE_VERSION} comments`}>
          <span class="release-label">Release</span>
          <span class="release-num">v{RELEASE_VERSION}</span>
        </a>
      </div>
      </div>
    </header>
    <main id="main" class:list={{ wide }}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <p>Open source · Zero cost · Grounded AI answers</p>
        <p>
          <a href={withBase("/vision")}>Vision</a>
          {" · "}
          <a href={withBase("/architecture")}>Architecture</a>
          {" · "}
          <a href={withBase("/quality")}>Quality</a>
          {" · "}
          <a href="https://github.com/jmaret/TestingRosettaStone">GitHub</a>
        </p>
      </div>
    </footer>
    <slot name="scripts" />
  </body>
</html>
