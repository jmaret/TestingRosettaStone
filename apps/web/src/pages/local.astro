---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/base";
---

<BaseLayout title="Run locally · Testing Playground">
  <div class="page-stack">
    <section class="scenario-hero">
      <h1>Run locally</h1>
      <p class="lede">
        Build and run Testing Playground on your machine from the GitHub repo — including under
        <code>~/Documents/CursorProjects</code> on macOS.
      </p>
    </section>

    <ol class="local-steps">
      <li>
        <strong>Clone into your Cursor projects folder</strong>
        <pre class="code-block"><code>mkdir -p ~/Documents/CursorProjects
cd ~/Documents/CursorProjects
git clone https://github.com/jmaret/TestingRosettaStone.git
cd TestingRosettaStone
git checkout cursor/build-phase1-7617</code></pre>
      </li>
      <li>
        <strong>Install dependencies</strong>
        <pre class="code-block"><code>npm install
npx playwright install chromium
brew install k6
python3 -m pip install pytest httpx</code></pre>
      </li>
      <li>
        <strong>Run the sample tests</strong>
        <pre class="code-block"><code>npm test</code></pre>
      </li>
      <li>
        <strong>(Optional) Refresh cached Results panel logs</strong>
        <pre class="code-block"><code>npm run capture:results</code></pre>
        <p class="meta" style="margin-top: 0.75rem;">
          Writes stdout/stderr JSON under <code>apps/web/public/results/</code>. CI does this before every site build.
        </p>
      </li>
      <li>
        <strong>Start the web app</strong>
        <pre class="code-block"><code>npm run dev</code></pre>
        <p class="meta" style="margin-top: 0.75rem;">Open http://localhost:4321 — scenario pages show code beside the last cached CI result.</p>
      </li>
    </ol>

    <section class="section">
      <h2>Requirements</h2>
      <p>Node.js 20+, npm 10+, Python 3.10+, pytest, Playwright Chromium for UX examples, and the k6 binary for load examples (<code>brew install k6</code>). Cypress, Artillery, and Autocannon install with <code>npm install</code>. Docker is not required.</p>
    </section>

    <section class="quality-block">
      <h2>Same gates in CI</h2>
      <p>
        GitHub Actions runs these commands before every GitHub Pages deploy.
        The <a href={withBase("/quality")}>Quality</a> page lists each gate.
      </p>
    </section>
  </div>
</BaseLayout>
