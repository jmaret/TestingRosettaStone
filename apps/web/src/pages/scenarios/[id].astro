---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  loadScenarios,
  loadScenario,
  readExampleFile,
  loadVariantResult,
  loadResultsManifest,
} from "../../lib/scenarios";

export function getStaticPaths() {
  return loadScenarios().map((s) => ({ params: { id: s.id } }));
}

const { id } = Astro.params;
const scenario = loadScenario(id!);
if (!scenario) {
  throw new Error(`Unknown scenario: ${id}`);
}

const manifest = loadResultsManifest();

const panels = scenario.variants.map((v) => ({
  ...v,
  code: readExampleFile(v.files[0]),
  fileLabel: v.files[0],
  sutCode: v.sutFile ? readExampleFile(v.sutFile) : null,
  sutLabel: v.sutFile ?? null,
  result: loadVariantResult(scenario.id, v.framework),
}));
---

<BaseLayout title={`${scenario.title} · Testing Playground`} description={scenario.summary} wide>
  <div class="page-stack">
    <section class="scenario-hero">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="crumbs-sep" aria-hidden="true">/</span>
        <a href="/scenarios">Scenarios</a>
        <span class="crumbs-sep" aria-hidden="true">/</span>
        <span aria-current="page">{scenario.title}</span>
      </nav>
      <span class="pill">{scenario.category}</span>
      <h1>{scenario.title}</h1>
      <p class="lede">{scenario.description}</p>
      <p class="meta">SUT: {scenario.sut} · id: {scenario.id}</p>
      {
        manifest && (
          <p class="meta">
            Cached CI results from {new Date(manifest.capturedAt).toLocaleString()} ({manifest.source}
            {manifest.gitSha ? ` · ${manifest.gitSha.slice(0, 7)}` : ""})
          </p>
        )
      }
      <div class="cta-row" style="margin-top: 1rem;">
        <a class="btn btn-ghost" href={`/ask?q=${encodeURIComponent(`Explain ${scenario.id}`)}`}>Ask AI about this</a>
        <a class="btn btn-ghost" href="/local">How to run</a>
      </div>
    </section>

    <div class="tabs" role="tablist" aria-label="Framework variants">
      {
        panels.map((p, i) => (
          <button
            class="tab"
            role="tab"
            type="button"
            id={`tab-${p.framework}`}
            aria-selected={i === 0 ? "true" : "false"}
            aria-controls={`panel-${p.framework}`}
            data-framework={p.framework}
          >
            {p.label}
          </button>
        ))
      }
    </div>

    {
      panels.map((p, i) => (
        <div
          class="panel"
          role="tabpanel"
          id={`panel-${p.framework}`}
          aria-labelledby={`tab-${p.framework}`}
          hidden={i !== 0}
        >
          {
            p.sutCode && p.sutLabel && (
              <div class="sut-block">
                <div class="toolbar">
                  <span>
                    Code under test · <code>{p.sutLabel}</code>
                  </span>
                  <button class="btn btn-ghost" type="button" data-copy={p.sutCode} style="padding: 0.4rem 0.7rem;">
                    Copy
                  </button>
                </div>
                <pre class="code-block"><code>{p.sutCode}</code></pre>
              </div>
            )
          }

          <div class="scenario-split">
            <div class="scenario-col">
              <div class="toolbar">
                <span>
                  Test · {p.fileLabel} · {p.frameworkLicense} · run in <code>{p.run.cwd}</code>:{" "}
                  <code>{p.run.command}</code>
                </span>
                <button class="btn btn-ghost" type="button" data-copy={p.code} style="padding: 0.4rem 0.7rem;">
                  Copy
                </button>
              </div>
              <pre class="code-block"><code>{p.code}</code></pre>
              {p.notes && <p class="notes">{p.notes}</p>}
            </div>

            <aside class="scenario-col results-col" aria-label={`${p.label} cached results`}>
              <div class="toolbar">
                <span>Results (cached from CI)</span>
                {p.result ? (
                  <span class:list={["status-pill", p.result.ok ? "status-ok" : "status-fail"]}>
                    {p.result.ok ? "passed" : "failed"} · exit {p.result.exitCode}
                  </span>
                ) : (
                  <span class="status-pill status-missing">missing</span>
                )}
              </div>
              {p.result ? (
                <>
                  <p class="meta results-meta">
                    <code>{p.result.command}</code> in <code>{p.result.cwd}</code>
                    <br />
                    Captured {new Date(p.result.capturedAt).toLocaleString()} · {p.result.durationMs}ms
                  </p>
                  <pre class="code-block results-log"><code>{p.result.output}</code></pre>
                </>
              ) : (
                <p class="notes">
                  No cached result yet. Run <code>npm run capture:results</code> locally, or wait for CI to
                  regenerate <code>apps/web/public/results/</code> on the next build.
                </p>
              )}
            </aside>
          </div>
        </div>
      ))
    }
  </div>
</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab[role="tab"]');
  const panels = document.querySelectorAll<HTMLElement>('.panel[role="tabpanel"]');

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const id = tab.dataset.framework;
      tabs.forEach((t) => t.setAttribute("aria-selected", String(t === tab)));
      panels.forEach((panel) => {
        panel.hidden = panel.id !== `panel-${id}`;
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>("button[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy ?? "";
      await navigator.clipboard.writeText(text);
      const prev = btn.textContent;
      btn.textContent = "Copied";
      setTimeout(() => {
        btn.textContent = prev;
      }, 1200);
    });
  });
</script>
