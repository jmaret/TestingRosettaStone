---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadScenarios } from "../../lib/scenarios";

const scenarios = loadScenarios();
---

<BaseLayout title="Scenarios · Testing Playground">
  <div class="page-stack">
    <section class="scenario-hero">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="crumbs-sep" aria-hidden="true">/</span>
        <span aria-current="page">Scenarios</span>
      </nav>
      <h1>Scenarios</h1>
      <p class="lede">
        Each scenario teaches one testing concept with parallel implementations you can run locally.
      </p>
    </section>

    <ul class="scenario-list">
      {
        scenarios.map((s) => (
          <li>
            <a href={`/scenarios/${s.id}`}>
              <span class="pill">{s.category}</span>
              <span>
                <strong>{s.title}</strong>
                <br />
                <span class="meta">{s.summary}</span>
              </span>
              <span class="meta">{s.id}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
