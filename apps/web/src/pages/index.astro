---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/base";
import { loadScenarios } from "../lib/scenarios";

const scenarios = loadScenarios();
---

<BaseLayout>
  <section class="hero">
    <div class="hero-panel">
      <p class="hero-brand">
        <img class="hero-logo" src={withBase("/images/logo.png")} width="72" height="72" alt="" />
        <span>Testing Playground</span>
      </p>
      <h1>Same test idea. Many open-source frameworks.</h1>
      <p>
        Side-by-side unit, HTTP, browser UX, performance, and security examples —
        with runnable samples and answers grounded in this repo.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={withBase("/scenarios")}>Browse scenarios</a>
        <a class="btn btn-ghost" href={withBase("/ask")}>Ask a question</a>
      </div>
    </div>
  </section>

  <section class="section content-panel">
    <h2>Which concept will you compare first?</h2>
    <p>Unit, HTTP, browser UX, performance, and security ideas, each expressed in several open-source frameworks.</p>
    <ul class="scenario-list">
      {
        scenarios.map((s) => (
          <li>
            <a href={withBase(`/scenarios/${s.id}`)}>
              <span class="pill">{s.category}</span>
              <span>
                <strong>{s.title}</strong>
                <br />
                <span class="meta">{s.summary}</span>
              </span>
              <span class="meta">{s.variants.length} frameworks</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
